        <bpmn:flowNodeRef>StartEvent_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_0rt48pj</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Tong_the_Lane_1" name="Ban Chủ nhiệm khoa">
        <bpmn:flowNodeRef>khoa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_Reject_khoa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_end_khoa_reject</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Tong_the_Lane_2" name="Đoàn trường">
