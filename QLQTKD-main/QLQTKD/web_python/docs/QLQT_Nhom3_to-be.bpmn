        <bpmn:flowNodeRef>return</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Tong_the_Lane_4" name="Phòng Kế hoạch Tài chính">
        <bpmn:flowNodeRef>EndEvent_2lj1aZfJYfbVwQsqGLI7_86</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>post</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:sequenceFlow id="Flow_New_1" sourceRef="StartEvent_start" targetRef="khoa" />
