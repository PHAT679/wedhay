# Khóa bí mật JWT dùng để mã hóa và xác thực phiên đăng nhập người dùng.
# (Tùy chọn: Nếu để trống, hệ thống tự động sử dụng khóa bảo mật sinh sẵn)
JWT_SECRET=

# Khóa Google Gemini API cho tính năng Trợ lý AI thẩm định đề án tự động.
# (Tùy chọn: Nếu để trống, hệ thống tự động chuyển sang bộ phân tích quy tắc rule-based)
# Lấy miễn phí tại: https://aistudio.google.com/apikey
AI_API_KEY=