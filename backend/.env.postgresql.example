# Server-only placeholders. Never copy these into VITE_* variables.
DATABASE_URL=postgresql://USER:PASSWORD@POOLER_HOST:6543/postgres?schema=my_due&pgbouncer=true&connection_limit=1&sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@DIRECT_HOST:5432/postgres?schema=my_due&sslmode=require
SUPABASE_INSPECT_URL=postgresql://READONLY_USER:PASSWORD@DIRECT_HOST:5432/postgres?sslmode=require
POSTGRES_CUTOVER_APPROVED=false
# Preserve the existing JWT secret when performing the approved cutover.
JWT_SECRET=
CORS_ORIGIN=https://YOUR_FRONTEND_HOST

STORAGE_DRIVER=supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=
# Use max 4 MB on Vercel to leave room for multipart overhead.
MAX_FILE_SIZE=4000000
