# CẤU HÌNH HỆ THỐNG MY DUE - PYTHON FLASK
# Kết nối Microsoft SQL Server Database MY_DUE_QLSK

SECRET_KEY=my-due-secret-key-super-secure-production-ready-2026

# SQL Server Configuration
DB_SERVER=.
DB_NAME=MY_DUE_QLSK
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUSTED_CONNECTION=yes
DB_TRUST_SERVER_CERTIFICATE=yes

# Cấu hình SQL Authentication (nếu không dùng Windows Authentication)
DB_USER=
DB_PASSWORD=

# Flask Server Configuration
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000
